# ============================================================
# VARIABLES DE ENTORNO — Numaris AI Hub
# ============================================================
# Copia este archivo a server/.env para desarrollo local.
# En Railway/Vercel configura cada variable en el dashboard.
# ============================================================

# ─── RAILWAY (Backend) ──────────────────────────────────────

# PostgreSQL — Railway lo genera automáticamente al agregar el plugin
DATABASE_URL="postgresql://user:password@host.railway.internal:5432/railway"

# Google OAuth — https://console.cloud.google.com/
# URI autorizado de redirección: https://TU-BACKEND.railway.app/api/auth/google/callback
GOOGLE_CLIENT_ID="123456789-abc.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_CALLBACK_URL="https://TU-BACKEND.railway.app/api/auth/google/callback"

# Seguridad — genera strings aleatorios largos
JWT_SECRET="cambia-esto-por-un-string-largo-y-aleatorio"
SESSION_SECRET="otro-string-largo-y-aleatorio"

# URL del frontend en Vercel (sin slash al final)
CLIENT_URL="https://numaris-ai-hub.vercel.app"

# Puerto — Railway lo asigna automáticamente vía la variable $PORT
PORT=3001
NODE_ENV="production"

# AI — usa OpenAI O Anthropic (al menos uno)
OPENAI_API_KEY="sk-proj-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu-api-secret"

# Slack Webhook (opcional, configurable desde el panel admin)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T.../B.../..."


# ─── VERCEL (Frontend) ──────────────────────────────────────
# Configura esta variable en: Vercel Dashboard → Project → Settings → Environment Variables

# URL del backend en Railway (sin slash al final)
VITE_API_URL="https://TU-BACKEND.railway.app"
